@{
    var authed = User.Identity?.IsAuthenticated == true;
    var uname = (User.Identity?.Name ?? "").Split('@')[0];
    var initial = uname.Length > 0 ? uname.Substring(0, 1).ToUpper() : "?";
    var ctrl = ViewContext.RouteData.Values["controller"] as string;
    var act = ViewContext.RouteData.Values["action"] as string;
}
<!DOCTYPE html>
<html lang="uk" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0d1016" />
    <title>@ViewData["Title"] - GameMatch</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Exo+2:wght@600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(authed ? "has-bnav" : "")">
<header class="topbar">
    <div class="container d-flex align-items-center gap-2">
        <a class="brand me-lg-3" asp-controller="Home" asp-action="Index">
            <svg viewBox="0 0 24 24"><polyline points="4 5 11 12 4 19"/><polyline points="13 5 20 12 13 19"/></svg>
            <span>Game<b>Match</b></span>
        </a>
        <nav class="d-none d-lg-flex gap-1">
            <a class="nl @(ctrl == "Home" ? "on" : "")" asp-controller="Home" asp-action="Index">Головна</a>
            @if (authed)
            {
                <a class="nl @(ctrl == "Lobbies" && act == "My" ? "on" : "")" asp-controller="Lobbies" asp-action="My">Мої лобі</a>
                <a class="nl @(ctrl == "Requests" ? "on" : "")" asp-controller="Requests" asp-action="My">Мої заявки</a>
            }
            @if (User.IsInRole("Admin"))
            {
                <a class="nl @(ctrl == "Admin" ? "on" : "")" asp-controller="Admin" asp-action="Index">Ігри</a>
            }
        </nav>
        <div class="ms-auto d-flex align-items-center gap-2">
            @if (authed)
            {
                <a class="btn btn-primary btn-sm d-none d-lg-inline-flex align-items-center gap-1" asp-controller="Lobbies" asp-action="Create">@Icons.Get("plus") Створити лобі</a>
                <a class="avatar" asp-controller="Profile" asp-action="Index" title="Профіль">@initial</a>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" class="d-none d-lg-block">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Вийти</button>
                </form>
            }
            else
            {
                <a class="nl" asp-area="Identity" asp-page="/Account/Login">Вхід</a>
                <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">Реєстрація</a>
            }
        </div>
    </div>
</header>

<main class="container py-4">
    @if (TempData["Success"] is string ok)
    {
        <div class="notice ok">@Icons.Get("check") <span>@ok</span></div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="notice err">@Icons.Get("x") <span>@err</span></div>
    }
    @RenderBody()
</main>

<footer class="text-center small py-4 d-none d-lg-block">GameMatch · навчальний проєкт · ASP.NET Core MVC</footer>

@if (authed)
{
    <nav class="bnav">
        <a class="@(ctrl == "Home" ? "on" : "")" asp-controller="Home" asp-action="Index">@Icons.Get("home")<span>Головна</span></a>
        <a class="@(ctrl == "Lobbies" && act == "My" ? "on" : "")" asp-controller="Lobbies" asp-action="My">@Icons.Get("list")<span>Мої лобі</span></a>
        <a class="mid" asp-controller="Lobbies" asp-action="Create"><span class="plus">@Icons.Get("plus")</span><span>Створити</span></a>
        <a class="@(ctrl == "Requests" ? "on" : "")" asp-controller="Requests" asp-action="My">@Icons.Get("inbox")<span>Заявки</span></a>
        <a class="@(ctrl == "Profile" ? "on" : "")" asp-controller="Profile" asp-action="Index">@Icons.Get("user")<span>Профіль</span></a>
    </nav>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
