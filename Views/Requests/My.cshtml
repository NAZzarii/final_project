@model List<LobbyRequest>
@{
    ViewData["Title"] = "Мої заявки";
}
<h1 class="h-title mb-3">Мої заявки</h1>
@if (Model.Count == 0)
{
    <div class="panel text-center py-5">
        <p class="muted mb-3">Ти ще не подавав заявок.</p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Знайти лобі</a>
    </div>
}
else
{
    <div class="d-grid gap-3">
    @foreach (var r in Model)
    {
        <div class="panel lobby" data-game="@UiHelpers.Slug(r.Lobby!.Game!.Name)">
            <div class="rowcard">
                <partial name="_GameIcon" model="r.Lobby.Game!" />
                <div class="grow">
                    <div class="gname">@r.Lobby.Game!.Name</div>
                    <div class="ltitle">@r.Lobby.Title</div>
                    <div class="muted small">Хост: @r.Lobby.Host!.DisplayName</div>
                </div>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <partial name="_StatusBadge" model="r.Status" />
                    <a class="btn btn-outline-secondary btn-sm" asp-controller="Lobbies" asp-action="Details" asp-route-id="@r.LobbyId">@(r.Status == RequestStatus.Accepted ? "Контакти" : "Відкрити")</a>
                    @if (r.Status == RequestStatus.Pending)
                    {
                        <form asp-action="Cancel" asp-route-id="@r.Id" method="post"><button class="btn btn-no btn-sm">Скасувати</button></form>
                    }
                </div>
            </div>
        </div>
    }
    </div>
}
