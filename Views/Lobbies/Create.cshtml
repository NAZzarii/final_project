@model CreateLobbyVm
@{
    ViewData["Title"] = "Створити лобі";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1 class="h-title mb-3">Нове лобі</h1>
        <div class="panel panel-pad">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="Напр. Faceit стак на вечір" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="GameId" class="form-label"></label>
                    <select asp-for="GameId" asp-items="(SelectList)ViewBag.Games" class="form-select">
                        <option value="0">Оберіть гру</option>
                    </select>
                    <span asp-validation-for="GameId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Рівень, правила, кого шукаєш"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label asp-for="PlayersNeeded" class="form-label"></label>
                        <input asp-for="PlayersNeeded" class="form-control" min="1" max="20" />
                        <span asp-validation-for="PlayersNeeded" class="text-danger"></span>
                    </div>
                    <div class="col-6 mb-3">
                        <label asp-for="PlayTime" class="form-label"></label>
                        <input asp-for="PlayTime" class="form-control" />
                        <span asp-validation-for="PlayTime" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-check form-switch mb-3">
                    <input asp-for="HasMic" class="form-check-input" role="switch" />
                    <label asp-for="HasMic" class="form-check-label"></label>
                </div>
                <div class="mb-4">
                    <label asp-for="ContactLink" class="form-label"></label>
                    <input asp-for="ContactLink" class="form-control" placeholder="https://discord.gg/..." />
                    <div class="form-text">Це посилання побачать лише гравці, яких ти прийняв.</div>
                    <span asp-validation-for="ContactLink" class="text-danger"></span>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary flex-grow-1 flex-md-grow-0">Створити лобі</button>
                    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Скасувати</a>
                </div>
            </form>
        </div>
    </div>
</div>
