@model List<Game>
@{
    ViewData["Title"] = "Довідник ігор";
}
<h1 class="h-title mb-3">Довідник ігор</h1>
<div class="row g-3">
    <div class="col-lg-4">
        <div class="panel panel-pad">
            <div class="sec">Додати гру</div>
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label">Назва</label>
                    <input name="name" class="form-control" maxlength="50" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Логотип (посилання, необов'язково)</label>
                    <input name="imageUrl" class="form-control" placeholder="https://..." />
                </div>
                <button class="btn btn-primary w-100">Додати</button>
            </form>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="d-grid gap-2">
        @foreach (var g in Model)
        {
            <div class="panel" data-game="@UiHelpers.Slug(g.Name)">
                <div class="rowcard">
                    <partial name="_GameIcon" model="g" />
                    <div class="grow"><strong>@g.Name</strong></div>
                    <form asp-action="Delete" asp-route-id="@g.Id" method="post" onsubmit="return confirm('Видалити гру?');">
                        <button class="btn btn-no btn-sm">@Icons.Get("trash") Видалити</button>
                    </form>
                </div>
            </div>
        }
        </div>
    </div>
</div>
